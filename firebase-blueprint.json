{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about registered students, teachers, and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth user identifier" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["student", "admin", "teacher"] },
        "phone": { "type": "string", "maxLength": 15 },
        "grade": { "type": "string", "maxLength": 20 },
        "enrolledCourses": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "Course": {
      "title": "Coaching Course",
      "description": "Details about academic and competitive courses offered",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "fees": { "type": "number" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "batchTiming": { "type": "string" },
        "syllabus": { "type": "array" },
        "facultyId": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "fees", "subject", "grade"]
    },
    "Note": {
      "title": "Study Note",
      "description": "Study material and PDFs available for purchase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "pagesCount": { "type": "number" },
        "rating": { "type": "number" },
        "downloadsCount": { "type": "number" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "price", "category", "subject", "pdfUrl"]
    },
    "Order": {
      "title": "Product Order",
      "description": "Details of note purchases and status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "finalAmount": { "type": "number" },
        "paymentId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "items", "totalAmount", "finalAmount", "status"]
    },
    "TestSeries": {
      "title": "Online Test Series",
      "description": "Interactive multiple choice question tests",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "questions": { "type": "array" },
        "totalMarks": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "subject", "grade", "durationMinutes", "questions", "totalMarks"]
    },
    "TestResult": {
      "title": "Student Test Result",
      "description": "Recorded outcomes of test attempts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "testId": { "type": "string" },
        "testTitle": { "type": "string" },
        "score": { "type": "number" },
        "totalMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "correctAnswers": { "type": "number" },
        "wrongAnswers": { "type": "number" },
        "timeSpentSeconds": { "type": "number" },
        "answers": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "testId", "score", "totalMarks", "percentage"]
    },
    "Blog": {
      "title": "Educational Blog",
      "description": "Articles, tips, and updates published by teachers or admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "author": { "type": "string" },
        "image": { "type": "string" },
        "likes": { "type": "number" },
        "comments": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "content", "category", "author"]
    },
    "ContactMessage": {
      "title": "Contact Form Submission",
      "description": "Messages sent from the Contact Us page",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["unread", "read", "replied"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "subject", "message"]
    },
    "AdmissionApplication": {
      "title": "Coaching Admission Application",
      "description": "Enquiry or registration form submitted by an aspiring student",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string", "maxLength": 100 },
        "parentName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "grade": { "type": "string" },
        "courseId": { "type": "string" },
        "previousMarks": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "studentName", "email", "phone", "grade", "courseId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Student and faculty profiles keyed by Auth UID"
    },
    "/courses/{courseId}": {
      "schema": "Course",
      "description": "Offered subjects, schedules, and syllabi"
    },
    "/notes/{noteId}": {
      "schema": "Note",
      "description": "Online store study materials and PDFs"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Note purchases, billing details, and receipt validation"
    },
    "/tests/{testId}": {
      "schema": "TestSeries",
      "description": "MCQ tests list and questions list"
    },
    "/results/{resultId}": {
      "schema": "TestResult",
      "description": "History of user results and performance"
    },
    "/blogs/{blogId}": {
      "schema": "Blog",
      "description": "Educational insights, news, and notifications"
    },
    "/contacts/{contactId}": {
      "schema": "ContactMessage",
      "description": "Inbound user queries from the Contact form"
    },
    "/admissions/{applicationId}": {
      "schema": "AdmissionApplication",
      "description": "Class registration and course enrollment forms"
    }
  }
}
